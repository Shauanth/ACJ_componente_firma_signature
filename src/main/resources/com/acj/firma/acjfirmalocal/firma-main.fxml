<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.image.ImageView?>
<BorderPane xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.acj.firma.acjfirmalocal.controller.FirmaController"
            style="-fx-background-color: #f8fafc;" prefWidth="650" prefHeight="550">

    <top>
        <VBox spacing="5.0" styleClass="app-header">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="20.0">
                    <children>
                        <ImageView fx:id="logoImage" fitHeight="40" preserveRatio="true" />

                        <VBox spacing="3.0" HBox.hgrow="SOMETIMES">
                            <children>
                                <Label fx:id="lblAppTitle" text="Componente de Firma Digital" styleClass="app-title">
                                    <font>
                                        <Font name="System Bold" size="22.0" />
                                    </font>
                                </Label>
                            </children>
                        </VBox>

                        <Region HBox.hgrow="ALWAYS" />

                        <VBox alignment="CENTER_RIGHT" spacing="4.0">
                            <VBox.margin>
                                <Insets top="-5.0" />
                            </VBox.margin>
                            <children>
                                <Label text="Versión 1.0" styleClass="app-version"
                                       style="-fx-font-size: 11px; -fx-font-weight: 500;" />
                            </children>
                        </VBox>
                    </children>
                    <VBox.margin>
                        <Insets bottom="10" />
                    </VBox.margin>
                </HBox>
            </children>
            <padding>
                <Insets bottom="0.0" left="25.0" right="25.0" top="20.0" />
            </padding>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;">
            <content>
                <VBox spacing="20.0" style="-fx-background-color: #f8fafc;"
                      minWidth="550.0" maxWidth="Infinity">
                    <children>

                        <VBox spacing="20.0" styleClass="card" style="-fx-padding: 25;"
                              minWidth="500.0" maxWidth="Infinity">
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="15.0">
                                    <children>
                                        <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                                            <children>
                                                <Label text="Elige el Certificado para la firma" styleClass="section-title" />
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>

                                <TextField fx:id="txtBuscarCertificado" promptText="Buscar certificado por nombre u organización..."
                                           styleClass="cert-search-field" />

                                <ScrollPane fitToWidth="true" prefHeight="290.0" maxHeight="360.0"
                                            style="-fx-background-color: transparent; -fx-background: transparent;">
                                    <content>
                                        <VBox fx:id="certificatesList" spacing="8.0" style="-fx-padding: 5;">
                                        </VBox>
                                    </content>
                                </ScrollPane>
                            </children>
                        </VBox>

                        <VBox spacing="20.0" styleClass="card" style="-fx-padding: 25;"
                              minWidth="500.0" maxWidth="Infinity">
                            <children>
                                <VBox spacing="20.0" alignment="CENTER">
                                    <children>

                                        <HBox spacing="15.0" alignment="CENTER">
                                            <children>
                                                <Button fx:id="btnCancel"
                                                        text="CANCELAR"
                                                        onAction="#onCancelar"
                                                        styleClass="btn-secondary-acj"
                                                        prefHeight="45.0" prefWidth="120.0" />

                                                <Button fx:id="btnSign"
                                                        text="FIRMAR DOCUMENTOS"
                                                        defaultButton="true"
                                                        onAction="#onSignDocuments"
                                                        styleClass="btn-primary-acj"
                                                        prefHeight="45.0" prefWidth="200.0" />
                                            </children>
                                        </HBox>

                                        <VBox spacing="8.0" styleClass="card" style="-fx-padding: 16;"
                                              minWidth="460.0" maxWidth="Infinity">
                                            <children>
                                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                                    <children>
                                                        <Label text="Registro de actividad" styleClass="section-title" style="-fx-font-size: 13px;" />
                                                        <Region HBox.hgrow="ALWAYS" />
                                                        <Button text="Abrir carpeta"
                                                                styleClass="btn-outline-acj"
                                                                onAction="#onAbrirCarpetaLogs" />
                                                        <Button text="Borrar logs"
                                                                styleClass="btn-outline-acj"
                                                                onAction="#onBorrarLogs" />
                                                    </children>
                                                </HBox>
                                                <Label text="Por seguridad y transparencia se está almacenando el detalle del proceso dentro del ordenador."
                                                       styleClass="logs-info-label" wrapText="true" />
                                                <Label fx:id="lblLogsPath" text="" styleClass="logs-path-value" wrapText="true" />
                                            </children>
                                        </VBox>

                                    </children>
                                </VBox>
                            </children>
                        </VBox>

                    </children>
                    <padding>
                        <Insets bottom="30.0" left="30.0" right="30.0" top="20.0" />
                    </padding>
                </VBox>
            </content>
        </ScrollPane>
    </center>

</BorderPane>
